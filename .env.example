# Copy to .env and fill in. The .env file is gitignored and must never be committed.
#
# NOTHING HERE IS REQUIRED to reproduce the published results: the default path
# is offline and deterministic. `python run_evaluation.py` and the full test
# suite run with no keys, no quota and no network. These are only needed for
# --live, and for `python compare_live.py`.

# --- API keys -----------------------------------------------------------
GOOGLE_API_KEY=
GROQ_API_KEY=

# --- Models -------------------------------------------------------------
# Verified against the live catalogues on 18 Sept 2026. Provider model names are
# retired without notice -- gemini-3.1-pro and llama-3.3-70b-versatile both were --
# so if a live run returns 404, run `python compare_live.py --models` to list what
# the key can actually reach and set the names here.
C360_FAST_MODEL=gemini-3.1-flash-lite
C360_REASONING_MODEL=gemini-3.1-flash-lite
C360_GROQ_MODEL=openai/gpt-oss-20b

# --- Optional -----------------------------------------------------------
# Seconds before one request is abandoned. Every caller has a deterministic
# fallback, so a slow answer is worth less than a prompt one.
C360_REQUEST_TIMEOUT=25

# Force the deterministic path even when keys are present. The test suite sets
# this so a machine with keys never makes API calls during pytest.
# C360_OFFLINE=1

# Tracing, if you have a LangSmith key.
# LANGSMITH_API_KEY=
